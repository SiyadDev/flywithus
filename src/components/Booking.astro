---
import Icon from './Icon.astro';
import SplitHeading from './SplitHeading.astro';
import { business } from '../data/site';

const kinds = [
  { v: 'Flight Ticket', icon: 'plane', travel: true },
  { v: 'Tourist / Visit Visa', icon: 'visa' },
  { v: 'Attestation', icon: 'stamp' },
  { v: 'Passport', icon: 'passport' },
  { v: 'PCC', icon: 'badge' },
  { v: 'Visa Medical', icon: 'medical' },
  { v: 'Train Ticket', icon: 'train', travel: true },
  { v: 'Bus Ticket', icon: 'bus', travel: true },
  { v: 'Travel Insurance', icon: 'shield' },
  { v: 'Resort Booking', icon: 'palm' },
];
---

<section class="section book" id="book">
  <div class="wrap book-grid">
    <div class="book-intro">
      <div class="gate on-dark" data-reveal><span>Gate 03</span><span>Book in a minute</span></div>
      <SplitHeading text="Fill the pass. We'll take it from here." class="h2 on-dark" />
      <p class="lede" data-reveal style="--d:2">
        No accounts, no payment online. Your details open straight in WhatsApp, ready to send to our team, who reply with options and fares.
      </p>
      <ul class="book-points" data-reveal style="--d:3">
        <li><Icon name="check" size={18} /> Real people reply, not a bot</li>
        <li><Icon name="check" size={18} /> Nothing is booked until you confirm</li>
        <li><Icon name="check" size={18} /> Prefer to talk? <a href={`tel:${business.phones[0].tel}`}>{business.phones[0].label}</a></li>
      </ul>
    </div>

    <form class="ticket" data-book data-reveal="scale" novalidate>
      <div class="ticket-main">
        <fieldset class="field">
          <legend class="mono flabel">What do you need?</legend>
          <div class="chips" role="radiogroup">
            {
              kinds.map((k, i) => (
                <label class="chip">
                  <input type="radio" name="service" value={k.v} checked={i === 0} data-travel={k.travel ? '1' : ''} />
                  <span>
                    <Icon name={k.icon} size={16} /> {k.v}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="trip" data-when="flight">
          <label class="pill"><input type="radio" name="trip" value="One way" checked /><span>One way</span></label>
          <label class="pill"><input type="radio" name="trip" value="Return" /><span>Return</span></label>
        </div>

        <div class="row two" data-when="travel">
          <label class="field">
            <span class="mono flabel">From</span>
            <input name="from" placeholder="City or airport" autocomplete="off" />
          </label>
          <button type="button" class="swap" aria-label="Swap from and to" data-swap><Icon name="swap" size={18} /></button>
          <label class="field">
            <span class="mono flabel">To</span>
            <input name="to" placeholder="City or airport" autocomplete="off" />
          </label>
        </div>

        <label class="field" data-when="visa">
          <span class="mono flabel">Country</span>
          <input name="country" placeholder="e.g. UAE, Malaysia, Oman" autocomplete="off" />
        </label>

        <div class="row" data-when="dated">
          <label class="field">
            <span class="mono flabel" data-date-label>Travel date</span>
            <input type="date" name="date" />
          </label>
          <label class="field" data-when="return">
            <span class="mono flabel">Return date</span>
            <input type="date" name="returnDate" />
          </label>
          <div class="field" data-when="travel">
            <span class="mono flabel">Travellers</span>
            <div class="stepper">
              <button type="button" aria-label="Fewer travellers" data-step="-1"><Icon name="minus" size={16} /></button>
              <output name="paxOut" aria-live="polite">1</output>
              <input type="hidden" name="pax" value="1" />
              <button type="button" aria-label="More travellers" data-step="1"><Icon name="plus" size={16} /></button>
            </div>
          </div>
        </div>

        <div class="row two-even">
          <label class="field">
            <span class="mono flabel">Your name</span>
            <input name="name" placeholder="Name" autocomplete="name" required />
            <span class="err" data-err>Please add your name so we know who to reply to.</span>
          </label>
          <label class="field">
            <span class="mono flabel">Anything else?</span>
            <input name="notes" placeholder="Optional" />
          </label>
        </div>

        <button class="btn btn-wa submit" type="submit">
          <Icon name="whatsapp" size={20} /> Send on WhatsApp
          <span class="takeoff" aria-hidden="true"><Icon name="plane" size={18} /></span>
        </button>
      </div>

      <aside class="stub" aria-hidden="true">
        <div class="stub-row">
          <span class="mono">Fly With Us</span>
          <span class="mono stub-svc" data-out="service">Flight Ticket</span>
        </div>
        <div class="stub-route">
          <strong data-out="from">···</strong>
          <span class="stub-line"><Icon name="plane" size={18} /></span>
          <strong data-out="to">···</strong>
        </div>
        <div class="stub-meta">
          <div><span class="mono">Date</span><b data-out="date">— —</b></div>
          <div><span class="mono">Pax</span><b data-out="pax">01</b></div>
          <div><span class="mono">Name</span><b data-out="name">—</b></div>
        </div>
        <div class="stub-code" />
      </aside>
    </form>
  </div>
</section>

<style>
  .book {
    background: var(--navy-deep);
    color: #fff;
    overflow: hidden;
  }
  .book::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 85% 10%, rgba(30, 143, 225, 0.35), transparent 70%),
      radial-gradient(40% 40% at 0% 100%, rgba(90, 140, 198, 0.25), transparent 70%);
    pointer-events: none;
  }
  .book-grid {
    position: relative;
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1080px) {
    .book-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
      align-items: center;
    }
  }
  .book :global(.h2.on-dark) {
    color: #fff;
  }
  .book .lede {
    color: rgba(255, 255, 255, 0.75);
    margin-top: 1.2rem;
  }
  .book-points {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .book-points li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .book-points :global(.icon) {
    color: var(--signal);
    flex: none;
  }
  .book-points a {
    color: #fff;
    font-weight: 600;
  }

  /* Ticket */
  .ticket {
    display: grid;
    background: var(--card);
    color: var(--ink);
    border-radius: 22px;
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.7);
    position: relative;
  }
  @media (min-width: 760px) {
    .ticket {
      grid-template-columns: 1fr 240px;
    }
  }
  .ticket-main {
    padding: clamp(22px, 3.4vw, 36px);
    display: grid;
    gap: 1.2rem;
    min-width: 0;
  }
  fieldset.field {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .flabel {
    font-size: var(--label-form);
    color: var(--ink-3);
    padding: 0;
  }
  .flabel em {
    font-style: normal;
    text-transform: none;
    letter-spacing: 0;
  }
  .field input {
    width: 100%;
    border: 0;
    border-bottom: 1.5px solid var(--rule);
    background: transparent;
    padding: 0.55rem 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--navy);
    border-radius: 0;
    transition: border-color 0.3s;
    -webkit-appearance: none;
    appearance: none;
    min-height: 44px;
  }
  .field input::placeholder {
    color: var(--placeholder);
    font-weight: 500;
  }
  .field input.is-empty {
    color: var(--placeholder);
    font-weight: 500;
  }
  .field input:focus {
    outline: none;
    border-color: var(--sky);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 0.3rem;
  }
  @media (max-width: 559px) {
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      margin-inline: calc(clamp(22px, 3.4vw, 36px) * -1);
      padding: 2px clamp(22px, 3.4vw, 36px) 6px;
      mask-image: linear-gradient(90deg, transparent, #000 18px, #000 calc(100% - 28px), transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 18px, #000 calc(100% - 28px), transparent);
    }
    .chips::-webkit-scrollbar {
      display: none;
    }
    .chip {
      flex: none;
      scroll-snap-align: start;
    }
  }
  .chip,
  .pill {
    position: relative;
  }
  .chip input,
  .pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--rule);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.16s var(--ease-out);
    user-select: none;
  }
  .chip span:active {
    transform: scale(0.96);
  }
  .chip input:checked + span {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .chip input:focus-visible + span,
  .pill input:focus-visible + span {
    outline: 2px solid var(--sky);
    outline-offset: 2px;
  }
  .trip {
    display: inline-flex;
    background: var(--paper-2);
    border-radius: 999px;
    padding: 4px;
    justify-self: start;
  }
  .pill span {
    display: grid;
    align-items: center;
    min-height: 40px;
    padding: 0 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .pill input:checked + span {
    background: #fff;
    color: var(--navy);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .row {
    display: grid;
    gap: 1.2rem;
  }
  @media (min-width: 560px) {
    .row {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
    .row.two {
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
    }
    .row.two-even {
      grid-template-columns: 1fr 1fr;
    }
  }
  .swap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--rule);
    background: #fff;
    color: var(--navy);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      transform 0.35s var(--ease-out),
      border-color 0.2s;
    justify-self: center;
  }
  .swap:hover {
    border-color: var(--navy);
  }
  .swap.spin {
    transform: rotate(180deg);
  }
  .stepper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    border-bottom: 1.5px solid var(--rule);
  }
  .stepper button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--paper-2);
    color: var(--navy);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .stepper output {
    min-width: 2ch;
    text-align: center;
    font-weight: 700;
    color: var(--navy);
    font-size: 1.05rem;
  }
  [data-when][hidden] {
    display: none !important;
  }
  .err {
    display: none;
    font-size: 0.8rem;
    color: var(--error);
  }
  .field.invalid input {
    border-color: var(--error);
  }
  .field.invalid .err {
    display: block;
  }
  .submit {
    justify-self: start;
    padding: 1.05rem 1.6rem;
    font-size: 1rem;
    margin-top: 0.4rem;
  }
  .takeoff {
    position: absolute;
    right: 14px;
    top: 50%;
    opacity: 0;
    transform: translate(-30px, -50%);
  }
  .submit.fly .takeoff {
    animation: takeoff 0.9s var(--ease-in-out) forwards;
  }
  @keyframes takeoff {
    0% {
      opacity: 1;
      transform: translate(-40px, -50%);
    }
    100% {
      opacity: 0;
      transform: translate(80px, -180%) rotate(-20deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .submit.fly .takeoff,
    .stub-route strong.pop {
      animation: none;
    }
  }
  /* Stub */
  .stub {
    position: relative;
    background: var(--navy);
    color: #fff;
    padding: 28px 24px;
    display: grid;
    align-content: space-between;
    gap: 1.2rem;
    /* phones: a compact stub under the form, torn off along a dashed line */
    border-radius: 0 0 22px 22px;
    border-top: 2px dashed rgba(255, 255, 255, 0.35);
  }
  @media (max-width: 759px) {
    .stub {
      padding: 20px 22px 22px;
      gap: 0.9rem;
    }
    .stub-route strong {
      font-size: 2rem !important;
    }
    .stub-code {
      height: 22px !important;
    }
  }
  @media (min-width: 760px) {
    .stub {
      border-radius: 0 22px 22px 0;
      border-top: 0;
      border-left: 2px dashed rgba(255, 255, 255, 0.35);
    }
  }
  .stub-row {
    display: flex;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-size: var(--label);
    color: var(--on-navy-soft);
    white-space: nowrap;
  }
  .stub-svc {
    color: var(--signal);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* narrow side stub (tablet/desktop): stack the brand above the service */
  @media (min-width: 760px) {
    .stub-row {
      flex-direction: column;
    }
    .stub-svc {
      text-align: left;
    }
  }
  .stub-route {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  @media (min-width: 760px) {
    .stub-route {
      flex-direction: column;
      align-items: flex-start;
    }
    .stub-line {
      transform: rotate(90deg);
      margin-left: 0.5rem;
    }
  }
  .stub-route strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: -0.01em;
    transition: color 0.3s;
  }
  .stub-route strong.pop {
    animation: pop 0.45s var(--ease-out);
  }
  @keyframes pop {
    0% {
      transform: translateY(6px);
      opacity: 0.3;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }
  .stub-line {
    color: var(--signal);
  }
  .stub-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  .stub-meta div {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .stub-meta div:last-child {
    grid-column: 1 / -1;
  }
  .stub-meta .mono {
    font-size: var(--label);
    color: var(--on-navy-soft);
  }
  .stub-meta b {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .stub-code {
    height: 34px;
    background: repeating-linear-gradient(90deg, #fff 0 2px, transparent 2px 4px, #fff 4px 5px, transparent 5px 8px, #fff 8px 11px, transparent 11px 12px);
    opacity: 0.7;
    border-radius: 3px;
  }
</style>

<script>
  import { business } from '../data/site';
  import { openWhatsApp } from '../scripts/whatsapp';

  const form = document.querySelector<HTMLFormElement>('[data-book]')!;
  const $ = <T extends Element = HTMLInputElement>(s: string) => form.querySelector<T>(s)!;
  const out = (k: string) => form.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
  const groups = [...form.querySelectorAll<HTMLElement>('[data-when]')];
  const visaLike = ['Tourist / Visit Visa', 'Visa Medical', 'Travel Insurance', 'Resort Booking'];

  const iata: Record<string, string> = {
    kochi: 'COK', cochin: 'COK', ernakulam: 'COK', kozhikode: 'CCJ', calicut: 'CCJ', karipur: 'CCJ',
    kannur: 'CNN', trivandrum: 'TRV', thiruvananthapuram: 'TRV', coimbatore: 'CJB', palakkad: 'PKD',
    mannarkkad: 'MKD', chennai: 'MAA', bangalore: 'BLR', bengaluru: 'BLR', mumbai: 'BOM', delhi: 'DEL',
    hyderabad: 'HYD', dubai: 'DXB', 'abu dhabi': 'AUH', sharjah: 'SHJ', riyadh: 'RUH', jeddah: 'JED',
    dammam: 'DMM', doha: 'DOH', qatar: 'DOH', muscat: 'MCT', oman: 'MCT', kuwait: 'KWI', bahrain: 'BAH',
    uae: 'UAE', 'kuala lumpur': 'KUL', malaysia: 'KUL', singapore: 'SIN', bangkok: 'BKK', thailand: 'BKK',
    male: 'MLE', 'malé': 'MLE', maldives: 'MLE', london: 'LHR',
  };
  const code = (s: string) => {
    const t = s.trim();
    if (!t) return '···';
    const k = t.toLowerCase();
    if (iata[k]) return iata[k];
    if (/^[a-z]{3}$/i.test(t)) return t.toUpperCase();
    return t.replace(/[^a-zA-Z]/g, '').slice(0, 3).toUpperCase() || '···';
  };
  const fmtDate = (v: string) => {
    if (!v) return '— —';
    const d = new Date(v + 'T00:00:00');
    return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
  };
  const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '';

  const state = () => {
    const svc = form.querySelector<HTMLInputElement>('input[name=service]:checked')!;
    const travel = svc.dataset.travel === '1';
    const flight = svc.value === 'Flight Ticket';
    const ret = flight && val('trip') === 'Return' && (form.querySelector<HTMLInputElement>('input[name=trip]:checked')!.value === 'Return');
    const visa = visaLike.includes(svc.value);
    return { svc: svc.value, travel, flight, ret, visa, dated: travel || visa };
  };

  let lastFrom = '';
  let lastTo = '';
  const sync = () => {
    const s = state();
    groups.forEach((g) => {
      const w = g.dataset.when;
      const show =
        (w === 'flight' && s.flight) ||
        (w === 'travel' && s.travel) ||
        (w === 'visa' && s.visa) ||
        (w === 'dated' && s.dated) ||
        (w === 'return' && s.ret);
      g.hidden = !show;
    });
    $('[data-date-label]').textContent = s.travel ? (s.ret ? 'Depart' : 'Travel date') : 'When';

    out('service').textContent = s.svc;
    const f = s.travel ? code(val('from')) : 'YOU';
    const t = s.travel ? code(val('to')) : s.visa ? code(val('country')) : '✓';
    const fe = out('from');
    const te = out('to');
    if (f !== lastFrom) {
      fe.textContent = f;
      fe.classList.remove('pop');
      void fe.offsetWidth;
      fe.classList.add('pop');
      lastFrom = f;
    }
    if (t !== lastTo) {
      te.textContent = t;
      te.classList.remove('pop');
      void te.offsetWidth;
      te.classList.add('pop');
      lastTo = t;
    }
    out('date').textContent = fmtDate(val('date'));
    out('pax').textContent = s.travel ? String(val('pax')).padStart(2, '0') : '—';
    out('name').textContent = val('name') || '—';
  };

  form.addEventListener('input', sync);
  form.addEventListener('change', sync);

  // Travellers stepper
  form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const pax = form.elements.namedItem('pax') as HTMLInputElement;
      const n = Math.min(20, Math.max(1, Number(pax.value) + Number(b.dataset.step)));
      pax.value = String(n);
      (form.elements.namedItem('paxOut') as HTMLOutputElement).value = String(n);
      sync();
    }),
  );

  // Swap from/to
  const swapBtn = $<HTMLButtonElement>('[data-swap]');
  swapBtn.addEventListener('click', () => {
    const a = form.elements.namedItem('from') as HTMLInputElement;
    const b = form.elements.namedItem('to') as HTMLInputElement;
    [a.value, b.value] = [b.value, a.value];
    swapBtn.classList.toggle('spin');
    sync();
  });

  // Dates can't be in the past
  // Local date (not UTC), so Indian customers can't pick yesterday between 00:00 and 05:30.
  const now = new Date();
  const today = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  const dates = [...form.querySelectorAll<HTMLInputElement>('input[type=date]')];
  const markEmpty = () => dates.forEach((d) => d.classList.toggle('is-empty', !d.value));
  dates.forEach((d) => {
    d.min = today;
    d.addEventListener('input', markEmpty);
    d.addEventListener('change', markEmpty);
  });
  const depart = form.elements.namedItem('date') as HTMLInputElement;
  const ret = form.elements.namedItem('returnDate') as HTMLInputElement;
  depart.addEventListener('change', () => {
    ret.min = depart.value || today;
    if (ret.value && ret.value < ret.min) ret.value = '';
    markEmpty();
  });
  markEmpty();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const s = state();
    const nameField = (form.elements.namedItem('name') as HTMLInputElement).closest('.field')!;
    if (!val('name').trim()) {
      nameField.classList.add('invalid');
      (form.elements.namedItem('name') as HTMLInputElement).focus();
      return;
    }
    nameField.classList.remove('invalid');

    const lines = ['Hello Fly With Us! ✈️', ''];
    lines.push(`*Service:* ${s.svc}${s.flight ? ` (${s.ret ? 'Return' : 'One way'})` : ''}`);
    if (s.travel) {
      if (val('from')) lines.push(`*From:* ${val('from')}`);
      if (val('to')) lines.push(`*To:* ${val('to')}`);
    }
    if (s.visa && val('country')) lines.push(`*Country:* ${val('country')}`);
    if (s.dated && val('date')) lines.push(`*${s.ret ? 'Depart' : 'Date'}:* ${fmtDate(val('date'))}`);
    if (s.ret && val('returnDate')) lines.push(`*Return:* ${fmtDate(val('returnDate'))}`);
    if (s.travel) lines.push(`*Travellers:* ${val('pax')}`);
    lines.push(`*Name:* ${val('name').trim()}`);
    if (val('notes').trim()) lines.push(`*Notes:* ${val('notes').trim()}`);

    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    btn.classList.remove('fly');
    void btn.offsetWidth;
    btn.classList.add('fly');
    // Same confirmation + device routing as every other WhatsApp link (see scripts/whatsapp.ts).
    openWhatsApp({ phone: business.whatsapp, text: lines.join('\n') });
  });

  (form.elements.namedItem('name') as HTMLInputElement).addEventListener('input', (e) => {
    if ((e.target as HTMLInputElement).value.trim()) (e.target as HTMLElement).closest('.field')!.classList.remove('invalid');
  });

  sync();
</script>
