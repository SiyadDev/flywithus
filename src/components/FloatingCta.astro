---
import Icon from './Icon.astro';
import { business, wa } from '../data/site';
---

<div class="float" data-float>
  <a class="fl fl-call" href={`tel:${business.phones[0].tel}`} aria-label={`Call ${business.phones[0].label}`}>
    <Icon name="phone" size={22} />
  </a>
  <a class="fl fl-wa" href={wa('Hi Fly With Us, I have an enquiry.')} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <span class="fl-label" aria-hidden="true">Chat with us</span>
    <Icon name="whatsapp" size={28} />
  </a>
</div>

<style>
  .float {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    opacity: 0;
    transform: translateY(24px) scale(0.96);
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.35s var(--ease-out);
  }
  .float.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .fl {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 14px 28px -12px rgba(5, 13, 58, 0.55);
    transition: transform 0.2s var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  .fl:active {
    transform: scale(0.95);
  }
  /* White with a navy ring so it stays visible on navy and on paper sections alike */
  .fl-call {
    width: 48px;
    height: 48px;
    background: #fff;
    color: var(--navy);
    box-shadow:
      0 0 0 1.5px rgba(11, 31, 126, 0.18),
      0 14px 28px -12px rgba(5, 13, 58, 0.55);
  }
  .fl-wa {
    width: 60px;
    height: 60px;
    background: var(--wa);
    color: #fff;
  }
  .fl-wa::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    animation: ring 2.6s var(--ease-out) 3; /* draws attention three times, then rests */
    animation-delay: 1s;
  }
  @keyframes ring {
    0% {
      box-shadow: 0 0 0 0 rgba(15, 122, 60, 0.5);
    }
    70%,
    100% {
      box-shadow: 0 0 0 16px rgba(15, 122, 60, 0);
    }
  }
  /* Hover label slides out from behind the button (transform + opacity only) */
  .fl-label {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--night);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    white-space: nowrap;
    opacity: 0;
    transform: translate(8px, -50%);
    pointer-events: none;
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  @media (hover: hover) {
    .fl:hover {
      transform: translateY(-2px);
    }
    .fl-wa:hover .fl-label,
    .fl-wa:focus-visible .fl-label {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fl-wa::before {
      animation: none;
    }
    .float {
      transform: none;
    }
  }
</style>

<script>
  import { onScroll } from '../scripts/frame';

  const el = document.querySelector<HTMLElement>('[data-float]')!;
  const book = document.getElementById('book');
  let bookOnScreen = false;
  // Hide while the booking form is on screen (it has its own send button) and while the menu is open.
  if (book) {
    new IntersectionObserver(([e]) => {
      bookOnScreen = e.isIntersecting;
      update();
    }, { rootMargin: '-20% 0px -20% 0px' }).observe(book);
  }
  const update = () => {
    const menuOpen = document.documentElement.classList.contains('menu-open');
    el.classList.toggle('show', window.scrollY > window.innerHeight * 0.6 && !bookOnScreen && !menuOpen);
  };
  onScroll(update);
  new MutationObserver(update).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>
