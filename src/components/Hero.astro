---
import Icon from './Icon.astro';
import { Picture } from 'astro:assets';
import { business, wa, services } from '../data/site';
import heroSky from '../assets/images/hero-sky.jpg';
import { heroWidths } from '../data/images';

const word = 'FLY WITH US'.split('');
const ticker = services.map((s) => s.title.toUpperCase());

const lastStar = Math.round((business.rating - Math.floor(business.rating)) * 100) || 100;
---

<section class="hero" id="top">
  <div class="hero-media" data-parallax="0.25" aria-hidden="true">
    <Picture src={heroSky} formats={['avif', 'webp']} widths={heroWidths} sizes="100vw" alt="" loading="eager" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <!-- Flight path drawn across the sky -->
  <svg class="hero-path" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path
      id="flightPath"
      d="M -60 640 C 240 560, 520 330, 780 230 S 1180 130, 1520 70"
      fill="none"
    />
    <g class="hero-plane" data-plane>
      <path
        d="M-14 -2 L14 -2 Q20 0 14 2 L-14 2 Z M2 -2 L-6 -14 L-1 -14 L9 -2 Z M2 2 L-6 14 L-1 14 L9 2 Z M-12 -2 L-16 -8 L-13 -8 L-8 -2 Z M-12 2 L-16 8 L-13 8 L-8 2 Z"
        fill="#fff"></path>
    </g>
  </svg>

  <div class="hero-inner wrap">
    <div class="hero-copy">
      <div class="gate on-dark hero-fade" style="--d:1"><span>Gate 01</span><span>Mannarkkad → The World</span></div>

      <p class="hero-script script hero-fade" style="--d:2">{business.script}</p>
      <h1 class="hero-title display" aria-label="Fly With Us">
        {
          word.map((ch, i) => (
            <span class="ch" style={`--i:${i}`} aria-hidden="true">
              {ch === ' ' ? ' ' : ch}
            </span>
          ))
        }
      </h1>
      <p class="hero-sub hero-fade" style="--d:6">
        <span class="hero-rule"></span>
        <span class="mono">Tours &amp; Travels</span>
        <span class="hero-rule"></span>
      </p>

      <p class="hero-lede hero-fade" style="--d:7">
        <strong>{business.tagline}.</strong> Flights, visas, attestation and passports, sorted by people you can
        meet, at our office opposite the Police Station in Mannarkkad.
      </p>

      <div class="hero-actions hero-fade" style="--d:8">
        <a class="btn btn-light" href="#book">
          Plan my trip <Icon name="arrow" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn-ghost hero-wa" href={wa('Hi Fly With Us, I would like to book a flight.')} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} /> Chat on WhatsApp
        </a>
      </div>

      <!-- Social proof as one quiet line, right where people decide -->
      <a class="trust hero-fade" style="--d:10" href="#reviews"
        aria-label={`Rated ${business.rating} out of 5 from ${business.reviewCount} Google reviews. Read the reviews.`}>
        <span class="trust-stars" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((i) => (
            <span class="tstar" style={`--i:${i}; --fill:${i === 4 ? lastStar : 100}%`}>
              <Icon name="star" size={15} />
              <span class="tstar-on"><Icon name="star" size={15} /></span>
            </span>
          ))}
        </span>
        <span class="trust-text" aria-hidden="true"><b>{business.rating}</b> · {business.reviewCount} Google reviews</span>
        <span class="trust-go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
      </a>
    </div>

    <!-- Boarding pass -->
    <div class="pass-wrap hero-fade" style="--d:9">
    <aside class="pass" data-tilt aria-label="Boarding pass: from wherever you are to wherever you're going">
      <div class="pass-top">
        <span class="mono">Boarding pass</span>
        <span class="pass-airline">FLY WITH US</span>
      </div>
      <div class="pass-route">
        <div>
          <span class="mono label">From</span>
          <strong data-flap-cycle="COK,DXB,BLR,DOH,LHR,MCT,SIN,JED">COK</strong>
          <span class="small">Wherever you are</span>
        </div>
        <span class="pass-plane"><Icon name="plane" size={22} /></span>
        <div class="right">
          <span class="mono label">To</span>
          <strong data-flap-cycle="DXB,LHR,SIN,COK,YYZ,BOM,KUL,MLE">DXB</strong>
          <span class="small">Wherever you're going</span>
        </div>
      </div>
      <div class="perf"></div>
      <p class="pass-hours"><Icon name="clock" size={14} /> Open every day · 10 am – 8 pm</p>
      <div class="pass-barcode" aria-hidden="true"></div>
    </aside>
    </div>
  </div>

  <!-- Departure-board ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {
        [0, 1].map(() => (
          <div class="ticker-group">
            {ticker.map((t) => (
              <span class="ticker-item">
                <span class="dot" />
                {t}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    overflow: hidden;
    background: var(--night);
  }
  .hero-media {
    position: absolute;
    inset: -8% 0 -8% 0;
    will-change: transform;
  }
  .hero-media :global(picture) {
    display: contents;
  }
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 60%;
    transform: scale(1.12);
    animation: heroZoom 2.4s var(--ease-out) forwards;
  }
  @keyframes heroZoom {
    to {
      transform: scale(1.02);
    }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(5, 13, 58, 0.94) 0%, rgba(7, 20, 90, 0.82) 38%, rgba(11, 31, 126, 0.25) 70%, rgba(11, 31, 126, 0.05) 100%),
      linear-gradient(0deg, rgba(5, 13, 58, 0.9) 0%, rgba(5, 13, 58, 0) 35%);
  }
  .hero-path {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* the route stays faint behind the text column and full strength in the open sky */
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 38%, #000 62%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 38%, #000 62%);
  }
  @media (max-width: 759px) {
    .hero-path {
      -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 12%, rgba(0, 0, 0, 0.15) 22%);
      mask-image: linear-gradient(180deg, #000 0%, #000 12%, rgba(0, 0, 0, 0.15) 22%);
    }
  }
  .hero-path path#flightPath {
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 1.6;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }
  .hero-plane {
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.35));
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 3rem;
    padding-top: 130px;
    padding-bottom: clamp(48px, 7vw, 88px);
    align-items: end;
  }
  @media (min-width: 1080px) {
    .hero-inner {
      grid-template-columns: 1fr 380px;
    }
  }

  .hero-script {
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    line-height: 1;
    margin: 0 0 -0.12em 0.08em;
    color: var(--on-navy-soft);
    position: relative;
    z-index: 1;
  }
  .hero-copy {
    min-width: 0;
    container-type: inline-size;
  }
  .hero-title {
    margin: 0;
    font-size: min(14.4cqi, 11.5rem);
    white-space: nowrap;
    display: flex;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .hero-title .ch {
    display: inline-block;
  }
  .js .hero-title .ch {
    transform: translateY(110%) rotate(6deg);
    animation: chUp 1.1s var(--ease-out) forwards;
    animation-delay: calc(250ms + var(--i) * 45ms);
  }
  @keyframes chUp {
    to {
      transform: none;
    }
  }
  .hero-sub {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.6rem 0 0;
    max-width: min(100%, 44rem);
  }
  .hero-sub .mono {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    letter-spacing: 0.36em;
    white-space: nowrap;
  }
  .hero-rule {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
  }
  .hero-lede {
    max-width: 33rem;
    font-size: clamp(1.02rem, 1.3vw, 1.15rem);
    color: rgba(255, 255, 255, 0.82);
    margin: 1.8rem 0 2rem;
  }
  .hero-lede strong {
    color: #fff;
    font-weight: 600;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .js .hero-fade {
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 1s var(--ease-out) forwards;
    animation-delay: calc(300ms + var(--d) * 90ms);
  }
  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: none;
    }
  }


  /* tablet portrait: centre the copy instead of leaving a tall empty sky above it */
  @media (min-width: 760px) and (max-width: 1079px) and (orientation: portrait) {
    .hero-inner {
      margin-block: auto;
    }
  }
  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }

  /* Reduced motion: no zoom, slides, flips or ticker; content simply fades in. */
  @keyframes fadeOnly {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-media :global(img) {
      animation: none;
      transform: none;
    }
    .js .hero-title .ch {
      transform: none;
      animation: none;
    }
    .js .hero-fade {
      transform: none;
      animation: fadeOnly 0.25s ease forwards;
      animation-delay: 0s;
    }
    .js .tstar-on {
      animation: none;
      clip-path: inset(0 calc(100% - var(--fill)) 0 0);
    }
    .ticker-track {
      animation: none;
    }
  }

  /* ── Rating line ── */
  .trust {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 1.4rem;
    padding: 6px 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.92rem;
    text-decoration: none;
  }
  .trust-stars {
    display: flex;
    gap: 2px;
  }
  .tstar {
    position: relative;
    display: inline-flex;
    color: rgba(255, 255, 255, 0.25);
  }
  .tstar-on {
    position: absolute;
    inset: 0;
    display: inline-flex;
    color: var(--signal);
    clip-path: inset(0 calc(100% - var(--fill)) 0 0);
  }
  .trust-text b {
    font-family: var(--font-display);
    font-weight: 800;
    color: #fff;
  }
  .trust-go {
    display: inline-flex;
    opacity: 0.6;
    transition:
      transform 0.2s var(--ease-out),
      opacity 0.2s;
  }
  @media (hover: hover) {
    .trust:hover {
      color: #fff;
    }
    .trust:hover .trust-go {
      opacity: 1;
      transform: translateX(3px);
    }
  }

  /* ── Phones: one clear action, WhatsApp as a light secondary, no decorative tag ── */
  @media (max-width: 759px) {
    .hero .gate {
      display: none;
    }
    .hero-lede {
      margin: 1.4rem 0 1.6rem;
    }
    .hero-actions {
      align-items: center;
      gap: 0.4rem 1.2rem;
    }
    .hero-wa {
      --bg: transparent;
      box-shadow: none;
      padding-inline: 0.2rem;
    }
    .hero-wa::after {
      display: none;
    }
    .trust {
      margin-top: 1.1rem;
    }
  }

  /* Boarding pass */
  .pass-wrap {
    display: none;
  }
  .pass {
    background: var(--card);
    color: var(--ink);
    border-radius: 18px;
    padding: 22px 22px 18px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
    transform-style: preserve-3d;
    transition: transform 0.4s var(--ease-out);
    position: relative;
  }
  @media (min-width: 1080px) {
    .pass-wrap {
      display: block;
    }
  }
  .pass::before,
  .pass::after {
    content: '';
    position: absolute;
    top: 118px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--navy-deep);
  }
  .pass::before {
    left: -11px;
  }
  .pass::after {
    right: -11px;
  }
  .pass-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--label);
    color: var(--ink-3);
  }
  .pass-airline {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--navy);
    font-size: 0.85rem;
  }
  .pass-route {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin: 18px 0 20px;
  }
  .pass-route > div {
    display: grid;
  }
  .pass-route .right {
    text-align: right;
  }
  .pass-route strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--navy);
    letter-spacing: -0.02em;
  }
  .label {
    font-size: var(--label);
    color: var(--ink-3);
  }
  .small {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .pass-plane {
    color: var(--sky);
    padding: 0 10px;
    position: relative;
  }
  .pass-hours {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 14px 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .pass-hours :global(.icon) {
    color: var(--sky-text);
  }
  .pass-barcode {
    height: 38px;
    border-radius: 4px;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 4px,
      var(--ink) 4px 5px,
      transparent 5px 8px,
      var(--ink) 8px 11px,
      transparent 11px 12px
    );
    opacity: 0.85;
  }

  /* Ticker */
  .ticker {
    position: relative;
    z-index: 2;
    background: var(--ticker);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    padding: 14px 0;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: tick 40s linear infinite;
  }
  .ticker-group {
    display: flex;
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding-right: 42px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    color: var(--signal);
    white-space: nowrap;
  }
  .ticker-item .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 640px) {
    .hero-inner {
      padding-top: 110px;
    }
    .hero-shade {
      background:
        linear-gradient(180deg, rgba(5, 13, 58, 0.55) 0%, rgba(5, 13, 58, 0.75) 45%, rgba(5, 13, 58, 0.96) 100%);
    }
  }
</style>

<script>
  import { onScroll, whileVisible, motionPaused, reduceMotion as reduce } from '../scripts/frame';

  const hero = document.getElementById('top')!;

  // Plane follows the dotted flight path, drawn in on load.
  const path = document.getElementById('flightPath') as SVGPathElement | null;
  const plane = document.querySelector<SVGGElement>('[data-plane]');

  if (path && plane) {
    const len = path.getTotalLength();
    const place = (t: number) => {
      const p = path.getPointAtLength(t * len);
      const q = path.getPointAtLength(Math.min(len, t * len + 1));
      const a = (Math.atan2(q.y - p.y, q.x - p.x) * 180) / Math.PI;
      plane.setAttribute('transform', `translate(${p.x} ${p.y}) rotate(${a}) scale(1.25)`);
    };
    path.style.strokeDashoffset = '0';

    if (reduce) {
      place(0.62);
    } else {
      // Mask the path so it "draws" behind the plane.
      const svg = path.ownerSVGElement!;
      const ns = 'http://www.w3.org/2000/svg';
      const mask = document.createElementNS(ns, 'mask');
      mask.id = 'pathMask';
      const reveal = path.cloneNode() as SVGPathElement;
      reveal.removeAttribute('id');
      reveal.setAttribute('stroke', '#fff');
      reveal.setAttribute('stroke-width', '8');
      reveal.style.strokeDasharray = `${len}`;
      reveal.style.strokeDashoffset = `${len}`;
      mask.appendChild(reveal);
      svg.prepend(mask);
      path.setAttribute('mask', 'url(#pathMask)');

      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const start = performance.now() + 600;
      const dur = 3200;
      // On phones the plane would park over the text, so it flies across and off-screen instead.
      const idleFrom = window.innerWidth < 760 ? 1 : 0.62;
      const intro = (now: number) => {
        const t = Math.max(0, Math.min(1, (now - start) / dur));
        const e = ease(t) * idleFrom;
        place(e);
        reveal.style.strokeDashoffset = `${len * (1 - e)}`;
        if (t < 1) requestAnimationFrame(intro);
        else onScroll(follow); // after the intro, scrolling flies the plane on
      };
      requestAnimationFrame(intro);

      // Scrolling the hero flies the plane toward the horizon; does nothing once it's off screen.
      let last = -1;
      const follow = () => {
        const h = window.innerHeight;
        const k = Math.min(1, Math.max(0, window.scrollY / (h * 0.9)));
        if (k === last) return;
        last = k;
        const e = Math.min(1, idleFrom + (1.02 - idleFrom) * k);
        place(e);
        reveal.style.strokeDashoffset = `${len * (1 - e)}`;
      };
    }
  }

  // Boarding-pass destination code cycles like a split-flap display.
  const flaps = [...document.querySelectorAll<HTMLElement>('[data-flap-cycle]')];
  if (flaps.length && !reduce) {
    const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let idx = 0;
    const flipTo = (flap: HTMLElement, target: string) => {
      let frame = 0;
      const iv = setInterval(() => {
        frame++;
        flap.textContent = target
          .split('')
          .map((c, i) => (frame > 6 + i * 3 ? c : A[Math.floor(Math.random() * 26)]))
          .join('');
        if (frame > 6 + target.length * 3) clearInterval(iv);
      }, 45);
    };
    // Only flips while the hero is on screen and motion isn't paused.
    let timer: number | undefined;
    whileVisible(
      hero,
      () => {
        timer = window.setInterval(() => {
          if (motionPaused()) return;
          idx++;
          flaps.forEach((f, k) => {
            const codes = f.dataset.flapCycle!.split(',');
            setTimeout(() => flipTo(f, codes[idx % codes.length]), k * 180);
          });
        }, 2800);
      },
      () => clearInterval(timer),
    );
  }

  // Gentle 3D tilt on the boarding pass
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (tilt && !reduce && window.matchMedia('(hover: hover)').matches) {
    tilt.addEventListener('pointermove', (e) => {
      const r = tilt.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.transform = `perspective(900px) rotateY(${x * 10}deg) rotateX(${-y * 10}deg)`;
    });
    tilt.addEventListener('pointerleave', () => (tilt.style.transform = ''));
  }
</script>
