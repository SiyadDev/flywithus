---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business, wa } from '../data/site';

const links = [
  { href: '#services', label: 'Services' },
  { href: '#book', label: 'Book' },
  { href: '#documents', label: 'Documents' },
  { href: '#destinations', label: 'Destinations' },
  { href: '#faq', label: 'FAQ' },
  { href: '#visit', label: 'Visit us' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a href="#top" class="nav-logo" aria-label="Fly With Us — home">
      <Logo size="sm" />
    </a>

    <nav class="nav-links" aria-label="Main">
      {links.map((l) => <a href={l.href} data-navlink>{l.label}</a>)}
    </nav>

    <div class="nav-cta">
      <a class="nav-phone mono" href={`tel:${business.phones[0].tel}`}>
        <Icon name="phone" size={16} />
        {business.phones[0].label}
      </a>
      <a class="btn btn-wa nav-wa" href={wa('Hi Fly With Us, I have an enquiry.')} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> <span>WhatsApp</span>
      </a>
      <button class="nav-burger" aria-label="Open menu" aria-expanded="false" data-burger>
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

  <div class="drawer" data-drawer hidden>
    <nav aria-label="Mobile">
      {
        links.map((l, i) => (
          <a href={l.href} style={`--i:${i}`} data-drawer-link>
            <span class="mono">0{i + 1}</span>
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="drawer-foot">
      <a href={`tel:${business.phones[0].tel}`} class="btn btn-light"><Icon name="phone" size={18} /> Call us</a>
      <a href={wa('Hi Fly With Us, I have an enquiry.')} class="btn btn-wa" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: #fff;
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 78px;
  }
  .nav-logo {
    text-decoration: none;
  }
  .nav :global(.logo-word) {
    color: #fff;
    transition: color 0.4s;
  }
  .nav :global(.logo-script) {
    color: var(--on-navy-soft);
  }
  .nav.scrolled {
    background: rgba(246, 244, 239, 0.88);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--rule);
  }
  .nav.scrolled :global(.logo-word) {
    color: var(--navy);
  }
  .nav.scrolled :global(.logo-script) {
    color: var(--steel);
  }
  .nav.hide {
    transform: translateY(-100%);
  }
  .nav-links {
    display: none;
    gap: 2rem;
  }
  .nav-links a {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    opacity: 0.85;
    padding-block: 0.4rem;
    transition: opacity 0.3s;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }
  .nav-links a:hover,
  .nav-links a.active {
    opacity: 1;
  }
  .nav-links a:hover::after,
  .nav-links a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-phone {
    display: none;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .nav-wa {
    padding: 0.7rem 1.05rem;
    font-size: 0.85rem;
  }
  .nav-burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
    border-radius: 50%;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 520px) {
    .nav-wa span {
      display: none;
    }
    .nav-wa {
      padding: 0;
      width: 44px;
      height: 44px;
      justify-content: center;
    }
  }
  @media (min-width: 1080px) {
    .nav-links {
      display: flex;
    }
    .nav-burger {
      display: none;
    }
  }
  @media (min-width: 1240px) {
    .nav-phone {
      display: inline-flex;
    }
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--navy-deep);
    color: #fff;
    padding: 110px var(--gutter) calc(32px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    clip-path: circle(0 at calc(100% - 40px) 40px);
    transition: clip-path 0.42s var(--ease-drawer);
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer {
      clip-path: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .drawer.open {
      opacity: 1;
    }
    .drawer nav a {
      transform: none !important;
    }
  }
  .drawer.open {
    clip-path: circle(150% at calc(100% - 40px) 40px);
  }
  .drawer nav {
    display: grid;
  }
  .drawer nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 8vw, 2.6rem);
    text-decoration: none;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .drawer.open nav a {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.12s + var(--i) * 35ms);
  }
  .drawer nav a .mono {
    font-size: 0.75rem;
    color: var(--signal);
  }
  .drawer-foot {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .nav.menu-open {
    color: #fff;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }
  .nav.menu-open :global(.logo-word) {
    color: #fff;
  }
</style>

<script>
  import { onScroll } from '../scripts/frame';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const drawer = nav.querySelector<HTMLElement>('[data-drawer]')!;
  const outside = [...document.querySelectorAll<HTMLElement>('main, footer, [data-float]')];
  const html = document.documentElement;
  let lastY = window.scrollY;
  let open = false;
  let savedY = 0;

  onScroll(() => {
    if (open) return;
    const y = window.scrollY;
    nav.classList.toggle('scrolled', y > 40);
    if (y > 600 && y > lastY + 4) nav.classList.add('hide');
    else if (y < lastY - 4) nav.classList.remove('hide');
    lastY = y;
  });

  // Menu: lock the page behind (iOS-safe), make it inert, and move focus into the menu.
  const setOpen = (v: boolean) => {
    if (v === open) return;
    open = v;
    burger.setAttribute('aria-expanded', String(v));
    burger.setAttribute('aria-label', v ? 'Close menu' : 'Open menu');
    nav.classList.toggle('menu-open', v);
    html.classList.toggle('menu-open', v);
    outside.forEach((el) => (el.inert = v));
    if (v) {
      savedY = window.scrollY;
      Object.assign(document.body.style, { position: 'fixed', top: `-${savedY}px`, left: '0', right: '0' });
      drawer.hidden = false;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          drawer.classList.add('open');
          drawer.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
        }),
      );
    } else {
      Object.assign(document.body.style, { position: '', top: '', left: '', right: '' });
      window.scrollTo({ top: savedY, behavior: 'instant' as ScrollBehavior });
      drawer.classList.remove('open');
      setTimeout(() => {
        if (!open) drawer.hidden = true;
      }, 420);
    }
  };
  burger.addEventListener('click', () => setOpen(!open));
  // Menu links: close first (restores scroll), then follow the link.
  drawer.querySelectorAll<HTMLAnchorElement>('[data-drawer-link]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      setOpen(false);
      requestAnimationFrame(() => document.querySelector(a.hash)?.scrollIntoView({ behavior: 'smooth' }));
      history.replaceState(null, '', a.hash);
    }),
  );
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) {
      setOpen(false);
      burger.focus();
    }
  });
  // Keep Tab inside the open menu (burger + menu links + menu buttons).
  nav.addEventListener('keydown', (e) => {
    if (!open || e.key !== 'Tab') return;
    const items = [burger, ...drawer.querySelectorAll<HTMLElement>('a')];
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Active section highlight; sections without a menu link clear it.
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-navlink]')];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          links.forEach((l) => l.classList.toggle('active', l.hash === `#${en.target.id}`));
        }
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main > section[id]').forEach((sec) => io.observe(sec));
</script>
