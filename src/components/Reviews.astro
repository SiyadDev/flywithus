---
import Icon from './Icon.astro';
import { business, reviews, ratingBreakdown } from '../data/site';

const bars = [
  { k: 5, n: ratingBreakdown.five },
  { k: 4, n: ratingBreakdown.four },
  { k: 3, n: ratingBreakdown.three },
  { k: 2, n: ratingBreakdown.two },
  { k: 1, n: ratingBreakdown.one },
];
const max = Math.max(...bars.map((b) => b.n));
const initials = (n: string) =>
  n
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section class="rating" id="reviews">
  <div class="wrap rating-inner">
    <div class="score" data-reveal>
      <span class="big" data-count-to={business.rating} data-decimals="1">{business.rating}</span>
      <span class="stars" aria-label={`${business.rating} out of 5 stars`}>
        {[0, 1, 2, 3, 4].map((i) => <span class="s" style={`--i:${i}`}><Icon name="star" size={26} /></span>)}
      </span>
      <ul class="bars" aria-label="Rating breakdown">
        {
          bars.map((b, i) => (
            <li style={`--w:${(b.n / max) * 100}%; --i:${i}`}>
              <span class="mono">{b.k}★</span>
              <span class="track"><span class="fill" /></span>
              <span class="mono n">{b.n}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="say" data-reveal style="--d:2">
      <p class="mono kicker">Google reviews</p>
      <p class="quote">
        <span data-count-to={business.reviewCount}>{business.reviewCount}</span> travellers have rated us on Google, and
        {ratingBreakdown.five} of them gave five stars.
      </p>
      <div class="actions">
        <a class="btn btn-light" href={business.reviewsUrl} target="_blank" rel="noopener">
          Read all reviews <Icon name="arrowUpRight" size={18} />
        </a>
        <a class="btn btn-ghost" href={business.reviewsUrl} target="_blank" rel="noopener">Travelled with us? Leave one</a>
      </div>
    </div>
  </div>

  {
    reviews.length > 0 && (
      <div class="marquee" data-reveal style="--d:3">
        <ul class="marquee-track" aria-label="Recent customer reviews from Google">
          {[0, 1].map((k) =>
            reviews.map((r, i) => (
              <li class={`rv ${i % 3 === 1 ? 'rv-alt' : ''}`} aria-hidden={k === 1 ? 'true' : undefined}>
                <div class="rv-top">
                  <span class="rv-stars" aria-label="5 out of 5 stars">
                    {[0, 1, 2, 3, 4].map(() => (
                      <Icon name="star" size={14} />
                    ))}
                  </span>
                  {r.tag && <span class="mono rv-tag">{r.tag}</span>}
                </div>
                <blockquote>“{r.text}”</blockquote>
                <div class="rv-who">
                  <span class="avatar" aria-hidden="true">{initials(r.name)}</span>
                  <span class="rv-name">
                    {r.name}
                    <small>
                      Google review{r.when && <> · {r.when}</>}
                    </small>
                  </span>
                </div>
              </li>
            )),
          )}
        </ul>
      </div>
    )
  }
</section>

<style>
  .rating {
    background: var(--navy);
    color: #fff;
    padding-block: clamp(72px, 10vw, 130px);
    position: relative;
    overflow: hidden;
  }
  .rating::before {
    content: 'FLY WITH US';
    position: absolute;
    right: -2vw;
    top: 0.1em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(6rem, 18vw, 17rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.08);
    white-space: nowrap;
    pointer-events: none;
  }
  .rating-inner {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .rating-inner {
      grid-template-columns: minmax(280px, auto) 1fr;
      gap: 5rem;
    }
  }
  .score {
    display: grid;
    gap: 0.7rem;
    max-width: 320px;
  }
  .big {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(6rem, 15vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }
  .stars {
    display: flex;
    gap: 4px;
    color: var(--signal);
  }
  .js .stars .s {
    opacity: 0;
    transform: scale(0.3) rotate(-40deg);
    transition:
      opacity 0.4s,
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(400ms + var(--i) * 90ms);
  }
  .js .score.in .stars .s {
    opacity: 1;
    transform: none;
  }
  .bars {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .bars li {
    display: grid;
    grid-template-columns: 2.2rem 1fr 2rem;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    color: #a9c8ef;
  }
  .bars .n {
    text-align: right;
    color: #fff;
  }
  .track {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: var(--signal);
    transform-origin: left;
  }
  .js .fill {
    transform: scaleX(0);
    transition: transform 1.1s var(--ease-out);
    transition-delay: calc(600ms + var(--i) * 80ms);
  }
  .js .score.in .fill {
    transform: none;
  }
  .kicker {
    font-size: 0.72rem;
    color: #a9c8ef;
    margin: 0 0 0.8rem;
  }
  .quote {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 2rem;
    max-width: 40rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* Review strip */
  .marquee {
    margin-top: clamp(56px, 7vw, 88px);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee-track {
    list-style: none;
    margin: 0;
    padding: 8px 0;
    display: flex;
    align-items: stretch;
    gap: 18px;
    width: max-content;
    animation: slide 70s linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  @keyframes slide {
    to {
      transform: translateX(calc(-50% - 9px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee-track li[aria-hidden='true'] {
      display: none;
    }
  }
  .rv {
    width: min(360px, 82vw);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 24px;
    border-radius: 16px;
    background: var(--card);
    color: var(--ink);
    position: relative;
    transition: transform 0.5s var(--ease-out);
  }
  .rv-alt {
    background: #13299a;
    color: #fff;
  }
  @media (hover: hover) {
    .rv:hover {
      transform: translateY(-6px) rotate(-0.6deg);
    }
  }
  .rv-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .rv-stars {
    color: #f2a900;
    display: flex;
    gap: 2px;
  }
  .rv-alt .rv-stars {
    color: var(--signal);
  }
  .rv-tag {
    font-size: 0.62rem;
    color: var(--sky);
  }
  .rv-alt .rv-tag {
    color: #a9c8ef;
  }
  .rv blockquote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    flex: 1;
  }
  .rv-who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule);
  }
  .rv-alt .rv-who {
    border-top-color: rgba(255, 255, 255, 0.2);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    flex: none;
  }
  .rv-alt .avatar {
    background: var(--signal);
    color: var(--night);
  }
  .rv-name {
    display: grid;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .rv-name small {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  .rv-alt .rv-name small {
    color: #a9c8ef;
  }
</style>
