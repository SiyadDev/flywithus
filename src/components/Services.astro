---
import Icon from './Icon.astro';
import { services, wa } from '../data/site';
import SplitHeading from './SplitHeading.astro';

const featured = services.filter((s) => s.image);
const rest = services.filter((s) => !s.image);
const ask = (t: string) => wa(`Hi Fly With Us, I need help with ${t}.`);
---

<section class="section services" id="services">
  <div class="wrap">
    <div class="section-head split">
      <div>
        <div class="gate" data-reveal><span>Gate 02</span><span>Services</span></div>
        <SplitHeading text="Every counter of the journey, at one desk." />
      </div>
      <p class="lede" data-reveal style="--d:2">
        Tickets, visas, stamping, passports — the paperwork that usually means five offices and a week of waiting. Bring
        it to us once.
      </p>
    </div>

    <div class="feat-grid">
      {
        featured.map((s, i) => (
          <a class={`feat feat-${i}`} href={ask(s.title)} target="_blank" rel="noopener" data-reveal="clip" style={`--d:${i}`}>
            <img src={s.image} alt="" loading="lazy" />
            <span class="feat-shade" />
            <span class="feat-no mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="feat-body">
              <span class="feat-tag mono">{s.short}</span>
              <span class="feat-title">{s.title}</span>
              <span class="feat-text">{s.body}</span>
              <span class="feat-cta">
                Ask on WhatsApp <Icon name="arrowUpRight" size={16} />
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="sign-grid">
      {
        rest.map((s, i) => (
          <a class="sign" href={ask(s.title)} target="_blank" rel="noopener" data-reveal style={`--d:${i % 4}`}>
            <span class="sign-top">
              <span class="sign-icon">
                <Icon name={s.icon} size={26} />
              </span>
              <span class="mono sign-no">{String(i + featured.length + 1).padStart(2, '0')}</span>
            </span>
            <span class="sign-title">{s.title}</span>
            <span class="sign-short mono">{s.short}</span>
            <span class="sign-text">{s.body}</span>
            <span class="sign-arrow">
              <Icon name="arrowUpRight" size={18} />
            </span>
          </a>
        ))
      }
      <a class="sign sign-cta" href={wa('Hi Fly With Us, I have a travel question.')} target="_blank" rel="noopener" data-reveal style="--d:3">
        <span class="sign-title">Something else?</span>
        <span class="sign-text">Not on the list? If it involves travel or travel documents, ask us first.</span>
        <span class="btn btn-wa">
          <Icon name="whatsapp" size={18} /> Ask us
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .feat-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .feat-grid {
      grid-template-columns: 1.35fr 1fr;
      grid-template-rows: 320px 320px;
    }
    .feat-0 {
      grid-row: span 2;
    }
    .feat {
      min-height: 0;
    }
  }
  .feat {
    position: relative;
    display: block;
    min-height: 340px;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--navy-deep);
    isolation: isolate;
  }
  .feat img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transform: scale(1.04);
    transition: transform 1.2s var(--ease-out);
  }
  .feat-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(5, 13, 58, 0.05) 20%, rgba(5, 13, 58, 0.88) 100%);
    transition: background 0.6s var(--ease-out);
  }
  .feat-no {
    position: absolute;
    top: 18px;
    left: 20px;
    font-size: 0.78rem;
    background: var(--signal);
    color: var(--night);
    padding: 0.3rem 0.55rem;
    border-radius: 5px;
  }
  .feat-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(20px, 3vw, 32px);
    display: grid;
    gap: 0.4rem;
  }
  .feat-tag {
    font-size: 0.72rem;
    color: #a9c8ef;
  }
  .feat-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .feat-0 .feat-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
  }
  .feat-text {
    color: rgba(255, 255, 255, 0.82);
    max-width: 32rem;
    font-size: 0.98rem;
  }
  .feat-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--signal);
  }
  @media (hover: hover) and (min-width: 760px) {
    .feat-text,
    .feat-cta {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(8px);
      transition:
        max-height 0.6s var(--ease-out),
        opacity 0.5s var(--ease-out),
        transform 0.6s var(--ease-out);
    }
    .feat-0 .feat-text,
    .feat-0 .feat-cta {
      max-height: 8rem;
      opacity: 1;
      transform: none;
    }
    .feat:hover .feat-text,
    .feat:hover .feat-cta,
    .feat:focus-visible .feat-text,
    .feat:focus-visible .feat-cta {
      max-height: 8rem;
      opacity: 1;
      transform: none;
    }
    .feat:hover img {
      transform: scale(1.1);
    }
    .feat:hover .feat-shade {
      background: linear-gradient(180deg, rgba(11, 31, 126, 0.3) 0%, rgba(5, 13, 58, 0.95) 100%);
    }
  }

  /* Signage tiles */
  .sign-grid {
    display: grid;
    gap: 16px;
    margin-top: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .sign-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .sign-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sign {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 24px;
    min-height: 260px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
    transition:
      color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .sign::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--navy);
    clip-path: circle(0 at 46px 46px);
    transition: clip-path 0.7s var(--ease-in-out);
  }
  .sign-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: auto;
    padding-bottom: 1.4rem;
  }
  .sign-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: var(--navy);
    color: #fff;
    transition:
      background 0.5s,
      color 0.5s;
  }
  .sign-no {
    font-size: 0.74rem;
    color: var(--ink-3);
    transition: color 0.5s;
  }
  .sign-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.28rem;
    line-height: 1.15;
    color: var(--navy);
    transition: color 0.5s;
  }
  .sign-short {
    font-size: 0.68rem;
    color: var(--sky);
    transition: color 0.5s;
  }
  .sign-text {
    font-size: 0.93rem;
    color: var(--ink-2);
    margin-top: 0.35rem;
    transition: color 0.5s;
  }
  .sign-arrow {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--signal);
    color: var(--night);
    transform: scale(0) rotate(-45deg);
    transition: transform 0.5s var(--ease-out);
  }
  @media (hover: hover) {
    .sign:not(.sign-cta):hover {
      color: #fff;
      border-color: var(--navy);
      transform: translateY(-4px);
    }
    .sign:not(.sign-cta):hover::before {
      clip-path: circle(150% at 46px 46px);
    }
    .sign:hover .sign-icon {
      background: var(--signal);
      color: var(--night);
    }
    .sign:hover .sign-title,
    .sign:hover .sign-no {
      color: #fff;
    }
    .sign:hover .sign-short {
      color: #a9c8ef;
    }
    .sign:hover .sign-text {
      color: rgba(255, 255, 255, 0.8);
    }
    .sign:hover .sign-arrow {
      transform: none;
    }
  }
  .sign-cta {
    background: var(--mist);
    border-color: transparent;
    justify-content: flex-end;
    gap: 0.6rem;
  }
  .sign-cta .btn {
    align-self: flex-start;
    margin-top: 0.8rem;
  }
</style>
