---
import SplitHeading from './SplitHeading.astro';
import { steps } from '../data/site';
---

<section class="section steps" id="how" data-steps>
  <div class="wrap">
    <div class="section-head">
      <div class="gate" data-reveal><span>Gate 06</span><span>How it works</span></div>
      <SplitHeading text="Three steps from your plan to your seat." />
    </div>

    <div class="track">
      <svg class="route" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
        <path class="route-base" d="M 20 90 C 260 10, 420 10, 600 60 S 940 120, 1180 30" />
        <path class="route-live" d="M 20 90 C 260 10, 420 10, 600 60 S 940 120, 1180 30" pathLength="1" />
      </svg>
      <ol class="step-list">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--d:${i * 2}`}>
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .steps {
    background: var(--paper-2);
    overflow: hidden;
  }
  .track {
    position: relative;
  }
  .route {
    display: none;
  }
  @media (min-width: 900px) {
    .route {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      width: 100%;
      height: 120px;
      overflow: visible;
    }
  }
  .route path {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .route-base {
    stroke: var(--rule);
    stroke-dasharray: 3 8;
  }
  .route-live {
    stroke: var(--navy);
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--p, 0));
  }
  .step-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
    position: relative;
  }
  @media (min-width: 900px) {
    .step-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
      padding-top: 150px;
    }
  }
  .step {
    position: relative;
    padding-left: 0;
  }
  .step-n {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(5rem, 10vw, 8.5rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--navy);
    margin-bottom: 1.2rem;
    transition: color 0.8s var(--ease-out);
  }
  .step.lit .step-n {
    color: var(--navy);
  }
  .step h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    color: var(--navy);
  }
  .step p {
    margin: 0;
    color: var(--ink-2);
    max-width: 22rem;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-steps]')!;
  const route = root.querySelector<SVGPathElement>('.route-live')!;
  const items = [...root.querySelectorAll<HTMLElement>('.step')];
  let ticking = false;
  const update = () => {
    const r = root.getBoundingClientRect();
    const vh = window.innerHeight;
    const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height * 0.75)));
    route.style.setProperty('--p', String(p));
    items.forEach((el, i) => el.classList.toggle('lit', p > (i + 0.5) / items.length - 0.1));
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();
</script>
