---
import '../styles/global.css';
import { business } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${business.fullName} · Mannarkkad — Flights, Visa, Attestation & Passport`,
  description = 'Fly With Us Tours & Travels, Mannarkkad. Flight tickets, tourist & visit visas, attestation, passport, PCC, train, bus, insurance and resort bookings. Rated 4.9 on Google.',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: business.fullName,
  telephone: business.phones.map((p) => p.tel),
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Opp. Police Station',
    addressLocality: 'Mannarkkad',
    addressRegion: 'Kerala',
    postalCode: '678582',
    addressCountry: 'IN',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: business.rating,
    reviewCount: business.reviewCount,
  },
  sameAs: [business.instagram],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1f7e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero-sky.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Great+Vibes&family=IBM+Plex+Mono:wght@500;600&family=Montserrat:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/images/hero-sky.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
