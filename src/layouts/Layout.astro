---
// Self-hosted fonts (latin subsets, only the weights in use)
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/montserrat/latin-900.css';
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '@fontsource/great-vibes/latin-400.css';
import montserrat900 from '@fontsource/montserrat/files/montserrat-latin-900-normal.woff2?url';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { business, asset } from '../data/site';
import heroSky from '../assets/images/hero-sky.jpg';
import { heroWidths } from '../data/images';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${business.fullName} · Flights, Visas, Attestation & Passport Services`,
  description = `Fly With Us Tours & Travels: flight tickets from anywhere to anywhere, tourist & visit visas, attestation, passport, PCC, train, bus, insurance and resort bookings. Rated ${business.rating} on Google.`,
} = Astro.props;

// Same files the hero <Picture> requests, so the preload is reused, not doubled.
const heroAvif = await getImage({ src: heroSky, format: 'avif', widths: heroWidths });
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(asset('/og.jpg'), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: business.fullName,
  telephone: business.phones.map((p) => p.tel),
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Opp. Police Station',
    addressLocality: 'Mannarkkad',
    addressRegion: 'Kerala',
    postalCode: '678582',
    addressCountry: 'IN',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: business.rating,
    reviewCount: business.reviewCount,
  },
  sameAs: [business.instagram],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1f7e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <link rel="preload" as="font" type="font/woff2" href={montserrat900} crossorigin />
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroAvif.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
